@model IEnumerable<DBM3.Models.Course>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

@if (TempData["DeleteError"] != null)
{
    <div class="alert alert-danger">
        @TempData["DeleteError"]
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Title)</th>
            <th>@Html.DisplayNameFor(model => model.LearningObjective)</th>
            <th>@Html.DisplayNameFor(model => model.CreditPoints)</th>
            <th>@Html.DisplayNameFor(model => model.DifficultyLevel)</th>
            <th>@Html.DisplayNameFor(model => model.PreRequisites)</th>
            <th>@Html.DisplayNameFor(model => model.Description)</th>
            <th>@Html.DisplayNameFor(model => model.Status)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Title)</td>
                <td>@Html.DisplayFor(modelItem => item.LearningObjective)</td>
                <td>@Html.DisplayFor(modelItem => item.CreditPoints)</td>
                <td>@Html.DisplayFor(modelItem => item.DifficultyLevel)</td>
                <td>@Html.DisplayFor(modelItem => item.PreRequisites)</td>
                <td>@Html.DisplayFor(modelItem => item.Description)</td>
                <td>@Html.DisplayFor(modelItem => item.Status)</td> <!-- Display Status -->
                <td>
                    <a asp-action="Edit" asp-route-id="@item.CourseId" class="btn btn-warning btn-sm">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.CourseId" class="btn btn-secondary btn-sm">Details</a> |
                    <!-- Form for Delete Action -->
                    <form asp-action="Delete" asp-route-id="@item.CourseId" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this course?');">
                            Delete
                        </button>
                    </form>
                    |
                    <a asp-action="ViewModules" asp-route-id="@item.CourseId" class="btn btn-info btn-sm">View Modules</a>
                </td>

            </tr>
        }
    </tbody>
</table>
