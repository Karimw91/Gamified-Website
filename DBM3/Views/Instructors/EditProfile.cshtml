@model DBM3.Models.Instructor

@{
    ViewData["Title"] = "Edit Profile";
}

<div class="container mt-5">
    <h2>Edit Profile</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <form asp-action="EditProfile" method="post">
        <input type="hidden" name="InstructorId" value="@Model.InstructorId" />

        <div class="form-group">
            <label for="FirstName">First Name</label>
            <input type="text" class="form-control" name="FirstName" value="@Model.FirstName" required />
        </div>

        <div class="form-group">
            <label for="LastName">Last Name</label>
            <input type="text" class="form-control" name="LastName" value="@Model.LastName" required />
        </div>

        <div class="form-group">
            <label for="Email">Email</label>
            <input type="email" class="form-control" name="Email" value="@Model.Email" required />
        </div>

        <div class="form-group">
            <label for="Password">Password</label>
            <input type="password" class="form-control" name="Password" value="@Model.Password" required />
        </div>

        <div class="form-group">
            <label for="ExpertiseArea">Expertise Area</label>
            <input type="text" class="form-control" name="ExpertiseArea" value="@Model.ExpertiseArea" />
        </div>

        <div class="form-group">
            <label for="LatestQualification">Latest Qualification</label>
            <input type="text" class="form-control" name="LatestQualification" value="@Model.LatestQualification" />
        </div>

        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Dashboard" asp-route-id="@Model.InstructorId" class="btn btn-secondary">Cancel</a>
    </form>
</div>

@section Styles {
    <style>
        .container {
            max-width: 600px;
        }
    </style>
}
