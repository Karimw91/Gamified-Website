@model IEnumerable<DBM3.Models.Module>

@{
    ViewData["Title"] = "Modules";
    var courseId = ViewBag.CourseId;
}

<h2>Modules for Course ID: @courseId</h2>

@if (Model == null || !Model.Any())
{
    <p>No modules are available for this course.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Module ID</th>
                <th>Title</th>
                <th>Difficulty</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var module in Model)
            {
                <tr>
                    <td>@module.ModuleId</td>
                    <td>@module.Title</td>
                    <td>@module.Difficulty</td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-action="EnrolledCourses" asp-controller="Learners" class="btn btn-secondary">Back to Enrolled Courses</a>
